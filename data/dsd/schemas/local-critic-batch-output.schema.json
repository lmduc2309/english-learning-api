{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dsd_entry_id", "decision", "reason_codes"],
        "properties": {
          "dsd_entry_id": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["pass", "repair", "quarantine"] },
          "reason_codes": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
