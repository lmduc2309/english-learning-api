{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["headword", "part_of_speech", "rationale"],
        "properties": {
          "headword": { "type": "string", "minLength": 1, "maxLength": 120 },
          "part_of_speech": { "type": "string", "minLength": 2, "maxLength": 32 },
          "rationale": { "type": "string", "minLength": 8, "maxLength": 240 }
        }
      }
    }
  }
}
