{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dsd_entry_id", "headword", "part_of_speech", "definition_en", "example_en", "usage_labels"],
        "properties": {
          "dsd_entry_id": { "type": "string", "minLength": 1 },
          "headword": { "type": "string", "minLength": 1, "maxLength": 120 },
          "part_of_speech": { "enum": ["noun", "verb", "adjective", "adverb", "pronoun", "preposition", "conjunction", "determiner", "interjection", "numeral", "phrase"] },
          "definition_en": { "type": "string", "minLength": 8, "maxLength": 320 },
          "example_en": { "type": "string", "minLength": 8, "maxLength": 320 },
          "usage_labels": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
