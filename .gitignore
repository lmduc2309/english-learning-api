logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/.git

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.claude/worktrees/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Environment variables
.env
.env.local
.env.*.local
deploy/.env.production

# Dependency directories
node_modules/

# Build
build/
dist/
data/

# Keep curation instructions and schemas versioned without tracking raw data dumps.
!data/
data/*
!data/learner-core/
data/learner-core/*
!data/learner-core/README.md
!data/learner-core/curation-template.json
!data/learner-core/source-manifest.json
!data/learner-core/NGSL-SOURCE.md
!data/learner-core/NOTICE.md
!data/learner-core/candidate-words.txt
!data/learner-core/ngsl-candidates.csv
!data/learner-core/ngsl-source-lock.json
!data/learner-core/OEWN-SOURCE.md
!data/learner-core/oewn-source-lock.json
!data/learner-core/oewn-ngsl-first-100-candidates.json
!data/learner-core/oewn-ngsl-first-100-headwords.csv
!data/learner-core/oewn-ngsl-first-100-senses.csv
!data/learner-core/pilot-ngsl-10-draft-2026-07-20.json
!data/learner-core/pilot-ngsl-10-review-worksheet.csv
!data/learner-core/licenses/
!data/learner-core/licenses/**
# Raw source bytes are checksum-locked but intentionally not committed.
data/learner-core/vendor/

# Local full-database review exports are large and contain generated snapshots.
reports/word-data-export-*/
reports/word-data-export-*.zip

# DSD corpus. data/* above already ignores everything here, so the three
# registries are re-included explicitly — they are the enforcement mechanism
# and must be version-controlled and CI-validated.
!data/dsd/
data/dsd/*
!data/dsd/source-registry.json
!data/dsd/tool-registry.json
!data/dsd/contributor-registry.json
# Inventory files and schemas are tracked deliverables: an inventory CSV is the
# evidence of a product decision, and the schema is the contract the tool
# enforces. They carry pseudonymous IDs only, never personal data.
!data/dsd/inventory/
data/dsd/inventory/*
!data/dsd/inventory/*.csv
!data/dsd/schemas/
data/dsd/schemas/*
!data/dsd/schemas/*.json
# Curation packages are the authorship record for every definition, translation
# and example in the corpus. They must be reviewable in a diff.
!data/dsd/curation/
data/dsd/curation/*
!data/dsd/curation/*.json
!data/dsd/curation/**/
!data/dsd/curation/**/*.json
# Review queues and decisions. The provenance ledger has no free-text column,
# so the reviewer's guidance lives here and the event points at it — these files
# are the review record, not a working artifact.
!data/dsd/reviews/
data/dsd/reviews/*
!data/dsd/reviews/*.json
# The similarity policy and its calibration set are the evidence behind every
# compliance verdict. Both are synthetic and both must be reviewable in a diff.
!data/dsd/similarity/
data/dsd/similarity/*
!data/dsd/similarity/*.json
!data/dsd/similarity/*.jsonl
# Tool locks pin what produced a candidate. They are the reproducibility
# record, so they belong in Git even though nothing is installed yet.
!data/dsd/tools/
data/dsd/tools/*
!data/dsd/tools/*.json
# The public-key registry is the trust root for offline verification. It holds
# public keys only and must be reviewable in a diff.
!data/dsd/release-public-keys.json

# Never re-include these: personal data, executed contracts, and generated
# artifacts. Only pseudonymous IDs and evidence IDs are committed — see
# docs/dsd-corpus/IP-ASSIGNMENT-CHECKLIST.md. The registry validator also
# rejects personal-data fields, so this is defence in depth, not the only line.
data/dsd/contracts/
data/dsd/private/
data/dsd/audio/
data/dsd/exports/
data/dsd/releases/

# One exception: a quarantine manifest records what was retired and with what
# hash. It has to survive the directory it describes, and it holds no audio —
# only paths, sizes, digests and a proposed action.
!data/dsd/audio/
data/dsd/audio/*
!data/dsd/audio/quarantine-*.json

# Local backup dumps and manifests. Snapshot-bound and reproducible;
# never committed. Off-host copies are the disaster-recovery path.
backups/
