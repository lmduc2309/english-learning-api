# Server Configuration
PORT=7474
NODE_ENV=development

# Production defaults to true even when omitted. When true, public dictionary
# and category responses contain only published learner-overlay content.
COMMERCIAL_SAFE_MODE=false
# Keep false until provider terms and generated-content rights are approved.
COMMERCIAL_ALLOW_GENERATED_CONTENT=false

# Browser origins allowed to call the API directly. Native mobile requests do
# not require CORS. Leave empty in development to allow local dev origins.
# CORS_ORIGINS=https://eng.dsdtech.site

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dictionary_user
DB_PASSWORD=dictionary_pass
DB_DATABASE=english_learning_db
# Keep migrations as the schema source of truth. Set to true only for a
# disposable local database where automatic schema mutation is intentional.
TYPEORM_SYNCHRONIZE=false

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# LLM Configuration (OpenRouter / OpenAI-compatible)
# Works with any OpenAI-compatible /v1/chat/completions endpoint
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Optional analytics headers for OpenRouter
LLM_APP_TITLE=english-learning-api
# LLM_HTTP_REFERER=https://your-app.example.com

# Dictionary LLM Fallback
# Set to 'false' to disable LLM fallback for dictionary lookups
LLM_FALLBACK_ENABLED=true

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Local TTS sidecar (VieNeu for Vietnamese, Piper for English).
# See tts-service/ for the sidecar implementation. Default port is 8001.
TTS_SERVICE_URL=http://localhost:8001

# ─── DSD corpus (separate database, separate roles) ────────────────────────
# Never equal to DB_DATABASE. The config layer refuses to start if it is.
DSD_DB_DATABASE=dsd_corpus_db
# off | internal | public. 'off' serves no DSD content and never falls back to
# legacy. 'internal' and 'public' require a reachable DSD connection.
#
# Activation is a two-step deploy: ship with 'off' or 'internal', verify the
# release, then set 'public'. A rollback returns to 'off' and never to legacy.
DSD_RELEASE_CHANNEL=off

# Required for 'internal' and 'public', ignored for 'off'. The scale is part of
# the identifier, so a pilot cannot be promoted by editing this value:
#   DSD-REL-PILOT-<yyyymmdd>-<8 hex>   never public-eligible
#   DSD-REL-V<n>-<count>-<8 hex>       public-eligible at 5,000 entries or more
DSD_ACTIVE_RELEASE_ID=

# One URL per role. No role falls back to another's credential.
DSD_APP_DATABASE_URL=postgres://dsd_app:CHANGE_ME@localhost:5432/dsd_corpus_db
DSD_CURATOR_DATABASE_URL=postgres://dsd_curator:CHANGE_ME@localhost:5432/dsd_corpus_db
DSD_AUDIT_DATABASE_URL=postgres://dsd_auditor:CHANGE_ME@localhost:5432/dsd_corpus_db
DSD_MIGRATOR_DATABASE_URL=postgres://dsd_migrator:CHANGE_ME@localhost:5432/dsd_corpus_db
DSD_BACKUP_DATABASE_URL=postgres://dsd_backup:CHANGE_ME@localhost:5432/dsd_corpus_db
# CREATEDB only; owns and drops uniquely guarded scratch databases during the
# scheduled restore rehearsal. It has no production content grant.
DSD_RESTORE_DATABASE_URL=postgres://dsd_restore_operator:CHANGE_ME@localhost:5432/postgres

# Task 8 only: column-scoped read-only view on the legacy database.
LEGACY_AUDIT_DATABASE_URL=postgres://dsd_similarity_reader:CHANGE_ME@localhost:5432/english_learning_db
LEGACY_HEADWORD_DATABASE_URL=postgres://dsd_headword_reader:CHANGE_ME@localhost:5432/english_learning_db
# Full legacy read for pg_dump only; never use DB_USERNAME as a fallback.
LEGACY_BACKUP_DATABASE_URL=postgres://legacy_backup:CHANGE_ME@localhost:5432/english_learning_db

# Authenticated users allowed to use the internal corpus review routes. Each
# listed UUID must still carry the admin or dsd_reviewer JWT role.
DSD_REVIEWER_USER_IDS=

# ── Database backup object storage (Task 2A) ────────────────────────────────
# The bucket must have versioning and Object Lock enabled. Pin the full KMS key
# ARN: HeadObject is required to return this exact value.
DSD_BACKUP_DIR=./backups
DSD_BACKUP_S3_URI=s3://dsd-backups/production/postgres
DSD_BACKUP_S3_REGION=ap-southeast-1
DSD_BACKUP_S3_ENDPOINT=
DSD_BACKUP_KMS_KEY_ID=
DSD_BACKUP_RETENTION_DAYS=30
DSD_RESTORE_MAX_AGE_HOURS=24
# In production this points at the read-only runtime-evidence volume.
DSD_BACKUP_PROOF_FILE=data/dsd/releases/backup-proof.json

# ── DSD audio object storage (Task 12A) ──────────────────────────────────────
# A dedicated, versioned, encrypted prefix. Keys are content-addressed, so the
# hash in a key is the hash of the bytes at that key.
#
# The storage audit refuses to run without all four of these. A missing KMS key
# is a critical finding, not a warning: an unencrypted prefix cannot pass the
# release gate. See docs/dsd-corpus/AUDIO-STORAGE.md.
DSD_AUDIO_S3_URI=s3://dsd-audio/dsd/audio
DSD_AUDIO_S3_REGION=ap-southeast-1
DSD_AUDIO_KMS_KEY_ID=
# The API serves through this base URL and an exact key from the database. It
# never lists the bucket — the serving role has no list permission at all.
DSD_AUDIO_PUBLIC_BASE_URL=https://cdn.dsdtech.site/audio
# Development only, for MinIO. Leave unset against AWS.
DSD_AUDIO_S3_ENDPOINT=

# Credentials used only by the permission proofs in
# scripts/dsd/audio-storage-permissions.spec.ts. They are not read by the
# application; the app and generator take credentials from their own roles.
DSD_AUDIO_GENERATOR_KEY=
DSD_AUDIO_GENERATOR_SECRET=
DSD_AUDIO_API_KEY=
DSD_AUDIO_API_SECRET=
DSD_AUDIO_OPERATOR_KEY=
DSD_AUDIO_OPERATOR_SECRET=
