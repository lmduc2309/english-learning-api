# Server Configuration
PORT=7474
NODE_ENV=development

# Browser origins allowed to call the API directly. Native mobile requests do
# not require CORS. Leave empty in development to allow local dev origins.
# CORS_ORIGINS=https://eng.dsdtech.site

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dictionary_user
DB_PASSWORD=dictionary_pass
DB_DATABASE=english_learning_db
# Keep migrations as the schema source of truth. Set to true only for a
# disposable local database where automatic schema mutation is intentional.
TYPEORM_SYNCHRONIZE=false

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# LLM Configuration (OpenRouter / OpenAI-compatible)
# Works with any OpenAI-compatible /v1/chat/completions endpoint
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Optional analytics headers for OpenRouter
LLM_APP_TITLE=english-learning-api
# LLM_HTTP_REFERER=https://your-app.example.com

# Dictionary LLM Fallback
# Set to 'false' to disable LLM fallback for dictionary lookups
LLM_FALLBACK_ENABLED=true

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Local TTS sidecar (VieNeu for Vietnamese, Piper for English).
# See tts-service/ for the sidecar implementation. Default port is 8001.
TTS_SERVICE_URL=http://localhost:8001
