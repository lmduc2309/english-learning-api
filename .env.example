# Server Configuration
PORT=7474
NODE_ENV=development

# Production defaults to true even when omitted. When true, public dictionary
# and category responses contain only published learner-overlay content.
COMMERCIAL_SAFE_MODE=false
# Keep false until provider terms and generated-content rights are approved.
COMMERCIAL_ALLOW_GENERATED_CONTENT=false

# Browser origins allowed to call the API directly. Native mobile requests do
# not require CORS. Leave empty in development to allow local dev origins.
# CORS_ORIGINS=https://eng.dsdtech.site

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dictionary_user
DB_PASSWORD=dictionary_pass
DB_DATABASE=english_learning_db
# Keep migrations as the schema source of truth. Set to true only for a
# disposable local database where automatic schema mutation is intentional.
TYPEORM_SYNCHRONIZE=false

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# LLM Configuration (OpenRouter / OpenAI-compatible)
# Works with any OpenAI-compatible /v1/chat/completions endpoint
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Optional analytics headers for OpenRouter
LLM_APP_TITLE=english-learning-api
# LLM_HTTP_REFERER=https://your-app.example.com

# Dictionary LLM Fallback
# Set to 'false' to disable LLM fallback for dictionary lookups
LLM_FALLBACK_ENABLED=true

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Local TTS sidecar (VieNeu for Vietnamese, Piper for English).
# See tts-service/ for the sidecar implementation. Default port is 8001.
TTS_SERVICE_URL=http://localhost:8001

# ─── DSD corpus (separate database, separate roles) ────────────────────────
# Never equal to DB_DATABASE. The config layer refuses to start if it is.
DSD_DB_DATABASE=dsd_corpus_db
# off | internal | public. 'off' serves no DSD content and never falls back to
# legacy. 'internal' and 'public' require a reachable DSD connection.
DSD_RELEASE_CHANNEL=off

# One URL per role. No role falls back to another's credential.
DSD_APP_DATABASE_URL=postgres://dsd_app:CHANGE_ME@localhost:5432/dsd_corpus_db
DSD_CURATOR_DATABASE_URL=postgres://dsd_curator:CHANGE_ME@localhost:5432/dsd_corpus_db
DSD_AUDIT_DATABASE_URL=postgres://dsd_auditor:CHANGE_ME@localhost:5432/dsd_corpus_db
DSD_MIGRATOR_DATABASE_URL=postgres://dsd_migrator:CHANGE_ME@localhost:5432/dsd_corpus_db
DSD_BACKUP_DATABASE_URL=postgres://dsd_backup:CHANGE_ME@localhost:5432/dsd_corpus_db

# Task 8 only: column-scoped read-only view on the legacy database.
LEGACY_AUDIT_DATABASE_URL=postgres://dsd_similarity_reader:CHANGE_ME@localhost:5432/english_learning_db
