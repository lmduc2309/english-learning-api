{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuditAndRecover",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::${DSD_AUDIO_BUCKET}",
        "arn:aws:s3:::${DSD_AUDIO_BUCKET}/*"
      ]
    }
  ]
}
