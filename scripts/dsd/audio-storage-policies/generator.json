{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAndReadAudioObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::${DSD_AUDIO_BUCKET}",
        "arn:aws:s3:::${DSD_AUDIO_BUCKET}/dsd/audio/*"
      ]
    }
  ]
}
