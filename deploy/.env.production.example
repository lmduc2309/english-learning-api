# Public origin shared by the Next.js website and Expo application.
PUBLIC_ORIGIN=https://eng.dsdtech.site

# Use 127.0.0.1 when a Cloudflare Tunnel runs on this same server.
# Use 0.0.0.0 only when the origin must accept direct network traffic.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

POSTGRES_USER=dictionary_user
POSTGRES_DB=english_learning_db
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Hard content boundary: never expose untraceable legacy/reference data.
COMMERCIAL_SAFE_MODE=true
COMMERCIAL_ALLOW_GENERATED_CONTENT=false

# Keep fallback disabled until a valid provider key and privacy policy are ready.
LLM_FALLBACK_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_APP_TITLE=DSD English

# DSD stays fail-closed until a signed, eligible release exists. Database URLs
# use distinct least-privilege roles; never reuse POSTGRES_USER or one DSD role
# for another purpose.
DSD_DB_DATABASE=dsd_corpus_db
DSD_RELEASE_CHANNEL=off
DSD_ACTIVE_RELEASE_ID=
DSD_APP_DATABASE_URL=postgres://dsd_app:replace-with-role-password@postgres:5432/dsd_corpus_db
DSD_CURATOR_DATABASE_URL=postgres://dsd_curator:replace-with-role-password@postgres:5432/dsd_corpus_db
DSD_AUDIT_DATABASE_URL=postgres://dsd_auditor:replace-with-role-password@postgres:5432/dsd_corpus_db
DSD_MIGRATOR_DATABASE_URL=postgres://dsd_migrator:replace-with-role-password@postgres:5432/dsd_corpus_db
DSD_BACKUP_DATABASE_URL=postgres://dsd_backup:replace-with-role-password@postgres:5432/dsd_corpus_db
DSD_RESTORE_DATABASE_URL=postgres://dsd_restore_operator:replace-with-role-password@postgres:5432/postgres
LEGACY_AUDIT_DATABASE_URL=postgres://dsd_similarity_reader:replace-with-role-password@postgres:5432/english_learning_db
LEGACY_BACKUP_DATABASE_URL=postgres://legacy_backup:replace-with-role-password@postgres:5432/english_learning_db
DSD_REVIEWER_USER_IDS=

# Production migrations require a versioned, Object-Locked off-host bucket,
# explicit KMS encryption and credentials scoped to the backup prefix.
DSD_BACKUP_S3_URI=s3://replace-with-backup-bucket/production/postgres
DSD_BACKUP_S3_REGION=ap-southeast-1
DSD_BACKUP_S3_ENDPOINT=
DSD_BACKUP_KMS_KEY_ID=replace-with-full-kms-key-arn
DSD_BACKUP_RETENTION_DAYS=30
DSD_RESTORE_MAX_AGE_HOURS=24
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
AWS_SESSION_TOKEN=

# Audio remains blocked until its rights gate and independently scoped object
# storage pass. This base URL alone never makes an asset release-eligible.
DSD_AUDIO_S3_URI=s3://replace-with-audio-bucket/dsd/audio
DSD_AUDIO_S3_REGION=ap-southeast-1
DSD_AUDIO_S3_ENDPOINT=
DSD_AUDIO_KMS_KEY_ID=replace-with-full-kms-key-arn
DSD_AUDIO_PUBLIC_BASE_URL=https://cdn.dsdtech.site/audio
