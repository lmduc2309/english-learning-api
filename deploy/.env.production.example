# Public origin shared by the Next.js website and Expo application.
PUBLIC_ORIGIN=https://eng.dsdtech.site

# Use 127.0.0.1 when a Cloudflare Tunnel runs on this same server.
# Use 0.0.0.0 only when the origin must accept direct network traffic.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

POSTGRES_USER=dictionary_user
POSTGRES_DB=english_learning_db
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Serve the dictionary already stored in the primary production database.
# Search never generates new entries or calls external providers with these
# defaults. Vietnamese matching is accent-insensitive and uses database indexes.
DICTIONARY_DATA_SOURCE=primary
DICTIONARY_ALLOW_GENERATED_FALLBACK=false
DICTIONARY_ALLOW_EXTERNAL_FALLBACK=false
DICTIONARY_VI_SEARCH=true

# Keep fallback disabled until a valid provider key and privacy policy are ready.
LLM_FALLBACK_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_APP_TITLE=DSD English
